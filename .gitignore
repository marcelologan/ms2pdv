# ==========================================
# Monorepo .gitignore
# ==========================================

# Dependências (todas as subpastas)
node_modules/
**/node_modules/

# Builds e Distribuição
dist/
**/dist/
build/
**/build/
.output/

# Variáveis de Ambiente e Segredos
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.env.local
**/.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
